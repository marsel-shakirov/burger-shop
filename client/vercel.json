{
  "rewrites": [
    {
      "source": "/api/docs",
      "destination": "/swagger.html"
    },
    {
      "source": "/api/docs/",
      "destination": "/swagger.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://burger-shop-api-lac.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
